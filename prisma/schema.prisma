generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ====================== NGƯỜI DÙNG ======================
model NguoiDung {
  id            String   @id @default(cuid())
  hoTen         String
  email         String   @unique
  matKhauHash   String
  vaiTro        VaiTro   @default(KHACH_HANG)
  soDienThoai   String?
  diaChi        String?
  ngayTao       DateTime @default(now())
  ngayCapNhat   DateTime @updatedAt

  // Quan hệ
  donHangs      DonHang[]
  cauHinhPCs    CauHinhPC[]
  tinNhanChats  TinNhanChat[]
  gioHangs      GioHang[]
  userKhuyenMais UserKhuyenMai[]

  @@map("nguoi_dung")
}

enum VaiTro {
  KHACH_HANG
  QUAN_TRI_VIEN
}

// ====================== SẢN PHẨM & DANH MỤC ======================
model DanhMuc {
  id          String    @id @default(cuid())
  tenDanhMuc  String
  moTa        String?
  sanPhams    SanPham[]

  @@map("danh_muc")
}

model SanPham {
  id            String   @id @default(cuid())
  tenSanPham    String
  slug          String   @unique
  gia           Float
  phanTramGiam  Int?     // Phần trăm giảm giá cho sản phẩm này (1-100)
  hinhAnh       String?
  hinhAnhs      String[] @default([])
  moTa          String?
  soLuongTon    Int      @default(100)
  thongSoKyThuat Json?   // Lưu socket, chipset, DDR, wattage...
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  danhMucId     String
  danhMuc       DanhMuc  @relation(fields: [danhMucId], references: [id])

  // Quan hệ
  chiTietDonHangs ChiTietDonHang[]
  buildItems      BuildItem[]
  gioHangItems    GioHangItem[]
  khuyenMaiSanPhams KhuyenMaiSanPham[]

  @@map("san_pham")
}

// ====================== KHUYẾN MÃI ======================
model KhuyenMai {
  id            String   @id @default(cuid())
  maKhuyenMai   String   @unique
  tenKhuyenMai  String
  moTa          String?
  phanTramGiam  Int      // Phần trăm giảm (1-100)
  ngayBatDau    DateTime
  ngayKetThuc   DateTime
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Quan hệ
  khuyenMaiSanPhams KhuyenMaiSanPham[]
  userKhuyenMais     UserKhuyenMai[]

  @@map("khuyen_mai")
}

model KhuyenMaiSanPham {
  id              String   @id @default(cuid())
  phanTramGiam    Int      // Phần trăm giảm riêng cho sản phẩm này (1-100)
  ngayBatDau      DateTime
  ngayKetThuc     DateTime
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  khuyenMaiId     String?
  khuyenMai       KhuyenMai?  @relation(fields: [khuyenMaiId], references: [id], onDelete: Cascade)

  sanPhamId       String
  sanPham         SanPham    @relation(fields: [sanPhamId], references: [id], onDelete: Cascade)

  @@unique([khuyenMaiId, sanPhamId])
  @@map("khuyen_mai_san_pham")
}

// ====================== BUILD PC ======================
model CauHinhPC {
  id              String      @id @default(cuid())
  tenCauHinh      String?
  tongGia         Float       @default(0)
  ngayTao         DateTime    @default(now())

  nguoiDungId     String
  nguoiDung       NguoiDung   @relation(fields: [nguoiDungId], references: [id], onDelete: Cascade)

  items           BuildItem[]

  @@map("cau_hinh_pc")
}

model BuildItem {
  id            String   @id @default(cuid())
  soLuong       Int      @default(1)

  cauHinhPCId   String
  sanPhamId     String

  cauHinhPC     CauHinhPC @relation(fields: [cauHinhPCId], references: [id], onDelete: Cascade)
  sanPham       SanPham   @relation(fields: [sanPhamId], references: [id], onDelete: Cascade)

  @@unique([cauHinhPCId, sanPhamId])
  @@map("build_item")
}

// ====================== GIỎ HÀNG ======================
model GioHang {
  id            String       @id @default(cuid())
  nguoiDungId   String       @unique
  nguoiDung     NguoiDung    @relation(fields: [nguoiDungId], references: [id], onDelete: Cascade)

  items         GioHangItem[]

  @@map("gio_hang")
}

model GioHangItem {
  id            String   @id @default(cuid())
  soLuong       Int      @default(1)

  gioHangId     String
  sanPhamId     String

  gioHang       GioHang  @relation(fields: [gioHangId], references: [id], onDelete: Cascade)
  sanPham       SanPham  @relation(fields: [sanPhamId], references: [id], onDelete: Cascade)

  @@unique([gioHangId, sanPhamId])
  @@map("gio_hang_item")
}

// ====================== ĐƠN HÀNG ======================
model DonHang {
  id                String         @id @default(cuid())
  maDonHang         String         @unique
  trangThai         TrangThaiDon   @default(CHO_XAC_NHAN)
  tongTien          Float
  diaChiGiaoHang    String
  ghiChu            String?
  ngayTao           DateTime       @default(now())

  nguoiDungId       String
  nguoiDung         NguoiDung      @relation(fields: [nguoiDungId], references: [id], onDelete: Cascade)

  chiTietDonHangs   ChiTietDonHang[]
  thanhToans        ThanhToan[]

  @@map("don_hang")
}

model ChiTietDonHang {
  id            String   @id @default(cuid())
  soLuong       Int
  giaBanLucMua  Float

  donHangId     String
  sanPhamId     String

  donHang       DonHang  @relation(fields: [donHangId], references: [id], onDelete: Cascade)
  sanPham       SanPham  @relation(fields: [sanPhamId], references: [id], onDelete: Cascade)

  @@map("chi_tiet_don_hang")
}

enum TrangThaiDon {
  CHO_XAC_NHAN
  DA_XAC_NHAN
  DANG_GIAO
  DA_GIAO
  DA_HUY
}

// ====================== THANH TOÁN ======================
model ThanhToan {
  id            String      @id @default(cuid())
  maThanhToan   String      @unique
  soTien        Float
  phuongThuc    String      // VNPAY, MOMO, COD...
  trangThai     String      @default("PENDING")
  ngayThanhToan DateTime?

  donHangId     String
  donHang       DonHang     @relation(fields: [donHangId], references: [id], onDelete: Cascade)

  @@map("thanh_toan")
}

// ====================== AI CHAT ======================
model TinNhanChat {
  id            String   @id @default(cuid())
  noiDung       String
  vaiTro        VaiTroTinNhan   // USER hoặc AI
  ngayTao       DateTime @default(now())

  nguoiDungId   String
  nguoiDung     NguoiDung @relation(fields: [nguoiDungId], references: [id], onDelete: Cascade)

  @@map("tin_nhan_chat")
}

enum VaiTroTinNhan {
  USER
  AI
}

// ====================== USER PROMOTIONS ======================
model UserKhuyenMai {
  id            String   @id @default(cuid())
  nguoiDungId   String
  khuyenMaiId   String
  daSuDung      Boolean  @default(false)
  ngayCap       DateTime @default(now())
  ngaySuDung    DateTime?

  nguoiDung     NguoiDung @relation(fields: [nguoiDungId], references: [id], onDelete: Cascade)
  khuyenMai     KhuyenMai @relation(fields: [khuyenMaiId], references: [id], onDelete: Cascade)

  @@unique([nguoiDungId, khuyenMaiId])
  @@map("user_khuyen_mai")
}

